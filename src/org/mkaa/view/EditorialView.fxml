<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.mkaa.controller.EditorialFXController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Gestión de Editoriales" />
            
            <TextField fx:id="txtNit" promptText="NIT" />
            <TextField fx:id="txtNombreEditorial" promptText="Nombre de la Editorial" />
            <TextField fx:id="txtDireccion" promptText="Dirección" />
            <TextField fx:id="txtTelefono" promptText="Teléfono" />
            
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="90" text="Guardar" />
                <Button onAction="#handleActualizarRegistro" prefWidth="90" text="Modificar" />
                <Button onAction="#handleEliminar" prefWidth="90" text="Eliminar" />
            </HBox>
            
            <HBox spacing="10">
                <Button onAction="#handleLimpiar" prefWidth="280" text="Limpiar Campos" />
            </HBox>
            
            <Label fx:id="lblMensaje" wrapText="true" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Editoriales" />
            
            <TableView fx:id="tablaEditoriales" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNit" prefWidth="100" text="NIT">
                        <cellValueFactory>
                            <PropertyValueFactory property="nit" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre Editorial">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombreEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDireccion" prefWidth="180" text="Dirección">
                        <cellValueFactory>
                            <PropertyValueFactory property="direccion" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colTelefono" prefWidth="120" text="Teléfono">
                        <cellValueFactory>
                            <PropertyValueFactory property="telefono" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" />
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>