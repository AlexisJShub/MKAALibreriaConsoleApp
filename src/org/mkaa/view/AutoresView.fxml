<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.mkaa.controller.AutoresFXController">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

    <left>
        <VBox spacing="10" minWidth="300" maxWidth="300">
            <padding><Insets right="20" /></padding>
            <Label text="Registrar Autor" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            <TextField fx:id="txtIdAutor" promptText="ID Autor" editable="false" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtApellido" promptText="Apellido" />
            <TextField fx:id="txtNacionalidad" promptText="Nacionalidad" />
            <TextArea fx:id="txtBiografia" promptText="Biografía" prefRowCount="4" wrapText="true" />
            <HBox spacing="10">
                <Button text="Guardar" onAction="#handleGuardar" prefWidth="120" />
                <Button text="Limpiar" onAction="#handleLimpiar" prefWidth="120" />
            </HBox>
            <HBox spacing="10">
                <Button text="Modificar" onAction="#handleActualizarRegistro" prefWidth="120" />
                <Button text="Eliminar" onAction="#handleEliminar" prefWidth="120" />
            </HBox>
            <Label fx:id="lblMensaje" wrapText="true" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label text="Lista de Autores" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            <TableView fx:id="tablaAutores">
                <columns>
                    <TableColumn text="ID" prefWidth="60">
                        <cellValueFactory>
                            <PropertyValueFactory property="idAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nombre" prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombreAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Apellido" prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="apellidoAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nacionalidad" prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="nacionalidad" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Biografía" prefWidth="220">
                        <cellValueFactory>
                            <PropertyValueFactory property="biografia" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Actualizar Tabla" onAction="#handleActualizar" />
                <Button text="Volver al Menú" onAction="#handleVolver" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
