<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.mkaa.controller.AutoresFXController">
    <left>
        <VBox>
            <Label text="Registrar Autor" />
            <TextField fx:id="txtIdAutor" promptText="ID Autor" />
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtApellido" promptText="Apellido" />
            <TextField fx:id="txtNacionalidad" promptText="Nacionalidad" />
            <TextArea fx:id="txtBiografia" promptText="Biografía" />
            <HBox>
                <Button text="Guardar" onAction="#handleGuardar" />
                <Button text="Limpiar" onAction="#handleLimpiar" />
            </HBox>
            <HBox>
                <Button text="Modificar" onAction="#handleActualizarRegistro" />
                <Button text="Eliminar" onAction="#handleEliminar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>
    <center>
        <VBox>
            <Label text="Lista de Autores" />
            <TableView fx:id="tablaAutores">
                <columns>
                    <TableColumn text="ID">
                        <cellValueFactory>
                            <PropertyValueFactory property="idAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nombre">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombreAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Apellido">
                        <cellValueFactory>
                            <PropertyValueFactory property="apellidoAutor" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nacionalidad">
                        <cellValueFactory>
                            <PropertyValueFactory property="nacionalidad" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Biografía">
                        <cellValueFactory>
                            <PropertyValueFactory property="biografia" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox>
                <Button text="Actualizar Tabla" onAction="#handleActualizar" />
                <Button text="Volver al Menú" onAction="#handleVolver" />
            </HBox>
        </VBox>
    </center>
</BorderPane>