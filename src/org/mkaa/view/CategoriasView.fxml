<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="607.0" prefWidth="1154.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.mkaa.controller.CategoriasFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Categoria" />
            <TextField fx:id="txtNombreCategoria" promptText="Nombre de categoria" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>
    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Categorias" />
            <HBox spacing="10" />
            <TableView fx:id="tablaCategorias" prefHeight="386.0" prefWidth="835.0">
               <columns>
                   <TableColumn fx:id="colId" prefWidth="150.0" text="ID" />
                   <TableColumn fx:id="colNombre" prefWidth="300.0" text="NOMBRE" />
               </columns>
            </TableView>
             <Button onAction="#handleActualizar" text="Actualizar Tabla" />
             <Button onAction="#handleVolver" text="Volver al Menú" />
        </VBox>
    </center>
</BorderPane>